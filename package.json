{
  "name": "tempestkeep-development-tools",
  "private": true,
  "description": "Development-only specifications and MCP Apps assets for the TempestKeep Go project",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "spec:check": "openspec validate --all --strict --no-interactive",
    "spec:list": "openspec list --specs",
    "openspec": "openspec",
    "app:build": "node scripts/build-mcp-app.mjs",
    "app:check": "node scripts/build-mcp-app.mjs --check",
    "app:test": "playwright test",
    "app:screenshots": "node scripts/capture-mcp-app.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  }
}
