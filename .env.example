# TempestKeep configuration.
# Run `tempestkeep setup`, or copy this file to .env in the working directory.
# On Unix-like systems, run `chmod 600 .env` before entering a token.
# Commands read .env only from their current working directory.
# The process environment wins, even when an environment value is empty.
# Values are literal: no shell expansion or inline comments.
# Put Windows paths with backslashes in single quotes.

# WeatherFlow personal access token. Keep it out of Git, chat, and arguments.
# Create a token at https://tempestwx.com under Settings > Data Authorizations.
# An existing archive can be read without a token.
TEMPEST_TOKEN=

# Optional: path to one device's SQLite archive.
# collect defaults to ./tempest.sqlite and can create it.
# Other commands use that default only when the file exists.
# To create an archive through MCP, set an explicit path and provide a token.
# Prefer an absolute path when the client uses a different working directory.
# Keep the active archive on a local filesystem, outside cloud-sync folders.
# TEMPEST_DB=/absolute/path/to/weather/tempest.sqlite

# Optional: device for CLI collection. A positive integer selects the device.
# Unset or 0 discovers the first Tempest device available to the token.
# MCP and live CLI views discover their device and do not use this variable.
# TEMPEST_DEVICE_ID=

# Optional: earliest date for CLI backfill on a new archive, YYYY-MM-DD.
# The date uses the process timezone. The default walks until history ends.
# This does not request historical gap repair on an existing archive.
# TEMPEST_BACKFILL_START=

# Optional: snapshots to keep after CLI collection, from 0 through 365.
# Backups live in the backups directory beside the archive.
# Default: 7. Zero disables backups. MCP collection does not create backups.
# TEMPEST_BACKUP_KEEP=7

# Optional: delay between historical API requests, from 0 through 60000 ms.
# Used by CLI collection and MCP archive tools. Default: 400. Zero disables it.
# TEMPEST_THROTTLE_MS=400

# Optional: live API cache lifetime, from 0 through 86400 seconds.
# Used by live CLI commands and MCP. Default: 300. Zero disables caching.
# TEMPEST_CACHE_TTL=300

# Optional: remove MCP archive write tools. This does not disable CLI collect.
# True: 1, true, yes, on. False: empty, 0, false, no, off. Case-insensitive.
# A true value cannot be overridden by --read-only=false.
# A token still permits live reads in read-only mode.
# TEMPEST_READ_ONLY=false

# Optional: API endpoint override for a trusted proxy or synthetic local test.
# The endpoint receives the token. Use HTTPS with real credentials.
# Plain HTTP is for synthetic tokens only. No URL credentials, query, or fragment.
# TEMPEST_API_BASE=http://127.0.0.1:8080

# Calendar reports use the process timezone, not a zone stored in the archive.
# On Unix-like systems, set TZ in the process environment before startup.
# For example: TZ=America/Los_Angeles bin/tempestkeep stats
# Native Windows uses the host timezone; TZ alone does not change it there.
