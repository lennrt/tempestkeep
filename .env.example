# TempestKeep configuration - copy to .env and fill in,
# or run `tempest setup` and let the wizard write it for you.
# Get a Personal Access Token:
#   https://tempestwx.com  ->  Settings  ->  Data Authorizations  ->  Create Token
TEMPEST_TOKEN=

# Optional: path to the SQLite archive (default: ./tempest.sqlite).
# Keep the active archive on a local filesystem. To move it between machines,
# stop TempestKeep first and copy a completed backup or export.
# TEMPEST_DB=tempest.sqlite

# Optional: Tempest device id. Auto-discovered from your token if unset.
# TEMPEST_DEVICE_ID=

# Optional: earliest date to backfill (YYYY-MM-DD).
# Default: walk back until history ends.
# TEMPEST_BACKFILL_START=

# Optional: how many backup snapshots to keep (default 7; set 0 to disable).
# TEMPEST_BACKUP_KEEP=7

# Optional: pause between historical REST requests, in milliseconds.
# Shared by `tempest collect` and the MCP archive tools (default 400; 0 disables).
# TEMPEST_THROTTLE_MS=400

# --- MCP server (tempest-mcp) options ---------------------------------------
# Optional: disable the archive write tools so the server can never mutate the db.
# TEMPEST_READ_ONLY=0
# Optional: seconds to cache live API responses in memory (default 300; 0 disables).
# TEMPEST_CACHE_TTL=300
